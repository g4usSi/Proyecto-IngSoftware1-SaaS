NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Debe coincidir con la configuración de PostgreSQL del equipo.
DATABASE_URL=postgresql://smartstorage:smartstorage_local@localhost:5433/smartstorage
# Secreto para firmar los JWT (mínimo 32 caracteres). Cambia este valor de ejemplo; en producción es obligatorio.
# Generar uno: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=secreto-solo-para-desarrollo-cambialo-por-uno-propio
# Duración de la sesión: número + s, m, h o d.
JWT_EXPIRES_IN=1h
# URL pública del frontend: se usa para armar los enlaces de los correos (verificación y recuperación).
FRONTEND_URL=http://localhost:5173
# Almacenamiento privado. Nunca exponer esta carpeta mediante express.static.
# Ruta relativa a la RAÍZ del repositorio, no a backend/.
STORAGE_ROOT=./storage
# Usar npm run dev:demo para activarlo solo durante esa ejecución local.
STORAGE_DEMO_ENABLED=false
# S3-04: proceso separado de conversión. Aún no admite subidas HTTP asíncronas.
REDIS_URL=redis://127.0.0.1:6379/0
IMAGE_WORKER_CONCURRENCY=2

# Envío de correos (verificación y recuperación) por SMTP, por ejemplo con Brevo.
# Configura las 5 o ninguna. Vacías en desarrollo: los enlaces se escriben en la consola del servidor.
# En producción son obligatorias. Nunca pongas credenciales reales en este archivo, solo en backend/.env.
# Brevo: usa SMTP_HOST=smtp-relay.sendinblue.com y SMTP_PORT=587 (con smtp-relay.brevo.com el
# certificado TLS no coincide y la conexión se rechaza). SMTP_FROM debe ser un remitente verificado en Brevo.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
