NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Debe coincidir con la configuración de PostgreSQL del equipo.
DATABASE_URL=postgresql://smartstorage:smartstorage_local@localhost:5433/smartstorage
# Secreto para firmar los JWT (mínimo 32 caracteres). Cambia este valor de ejemplo; en producción es obligatorio.
# Generar uno: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=secreto-solo-para-desarrollo-cambialo-por-uno-propio
# Duración de la sesión: número + s, m, h o d.
JWT_EXPIRES_IN=1h
# Almacenamiento privado. Nunca exponer esta carpeta mediante express.static.
# Ruta relativa a la RAÍZ del repositorio, no a backend/.
STORAGE_ROOT=./storage
# Usar npm run dev:demo para activarlo solo durante esa ejecución local.
STORAGE_DEMO_ENABLED=false
